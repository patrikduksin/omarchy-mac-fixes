[Unit]
Description=Recover PipeWire after broken audio hot-plug events
Wants=pipewire.socket pipewire-pulse.socket wireplumber.service
After=pipewire.socket pipewire-pulse.socket pipewire.service pipewire-pulse.service wireplumber.service

[Service]
Type=simple
ExecStart=@HOME@/.local/bin/omarchy-audio-graph-guard
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
