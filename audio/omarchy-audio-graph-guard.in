#!/usr/bin/env bash

set -u

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
lock_file="$runtime_dir/omarchy-audio-graph-guard.lock"
stamp_file="$runtime_dir/omarchy-audio-graph-guard.last-rebuild"
builtin_source="effect_output.j314-mic"
builtin_sink="audio_effect.j314-convolver"
known_sources=""
known_sinks=""
selected_source=""
selected_sink=""

audio_snapshot() {
  timeout 3 pactl list short "$1" 2>/dev/null
}

has_duplicate_names() {
  awk '
    $2 !~ /\.monitor$/ { count[$2]++ }
    END {
      for (name in count)
        if (count[name] > 1)
          exit 0
      exit 1
    }
  '
}

audio_graph_is_healthy() {
  local sources sinks mac_mic_count mac_sink_count external_sources external_sinks

  sources="$(audio_snapshot sources)" || return 1
  sinks="$(audio_snapshot sinks)" || return 1

  mac_mic_count="$(awk -v mic="$builtin_source" '$2 == mic { count++ } END { print count + 0 }' <<<"$sources")"
  if [[ "$mac_mic_count" -ne 1 ]]; then
    external_sources="$(external_nodes sources "$builtin_source")" || return 1
    [[ -n "$external_sources" ]] || return 1
  fi

  mac_sink_count="$(awk -v sink="$builtin_sink" '$2 == sink { count++ } END { print count + 0 }' <<<"$sinks")"
  if [[ "$mac_sink_count" -ne 1 ]]; then
    external_sinks="$(external_nodes sinks "$builtin_sink")" || return 1
    [[ -n "$external_sinks" ]] || return 1
  fi

  has_duplicate_names <<<"$sources" && return 1
  has_duplicate_names <<<"$sinks" && return 1
  return 0
}

wait_for_stable_audio_graph() {
  local stable_checks=0

  for _ in {1..40}; do
    if audio_graph_is_healthy; then
      stable_checks=$((stable_checks + 1))
      (( stable_checks >= 12 )) && return 0
    else
      stable_checks=0
    fi
    sleep 0.25
  done

  return 1
}

rebuild_audio_graph() {
  local now last_rebuild=0

  exec 9>"$lock_file"
  if ! flock -n 9; then
    exec 9>&-
    return 0
  fi

  if audio_graph_is_healthy; then
    flock -u 9
    exec 9>&-
    return 0
  fi

  now="$(date +%s)"
  if [[ -e "$stamp_file" ]]; then
    last_rebuild="$(stat -c %Y "$stamp_file" 2>/dev/null || printf 0)"
  fi
  if (( now - last_rebuild < 10 )); then
    flock -u 9
    exec 9>&-
    return 0
  fi
  touch "$stamp_file"

  logger -t omarchy-audio-graph-guard "Broken audio graph detected; restarting WirePlumber"

  # Reapply the selected physical device after recovery instead of letting
  # WirePlumber restore a device that may have just disconnected.
  wpctl clear-default 0 2>/dev/null || true
  wpctl clear-default 1 2>/dev/null || true
  systemctl --user restart wireplumber.service

  if ! wait_for_stable_audio_graph; then
    logger -t omarchy-audio-graph-guard "WirePlumber graph did not settle; retrying WirePlumber"
    systemctl --user restart wireplumber.service
    if ! wait_for_stable_audio_graph; then
      logger -t omarchy-audio-graph-guard "WirePlumber restart was not enough; rebuilding PipeWire"
      systemctl --user kill --kill-whom=all --signal=SIGKILL wireplumber.service 2>/dev/null || true
      systemctl --user stop pipewire-pulse.socket pipewire-pulse.service pipewire.socket pipewire.service || true
      systemctl --user reset-failed wireplumber.service
      systemctl --user start pipewire.socket pipewire.service wireplumber.service pipewire-pulse.socket pipewire-pulse.service

      wait_for_stable_audio_graph || true
    fi
  fi

  if audio_graph_is_healthy; then
    logger -t omarchy-audio-graph-guard "Audio graph recovered"
  else
    logger -t omarchy-audio-graph-guard "Audio graph rebuild completed but health check still fails"
  fi

  flock -u 9
  exec 9>&-
}

node_names() {
  local kind="$1"

  audio_snapshot "$kind" |
    awk '$2 !~ /\.monitor$/ && $2 !~ /\.Raw(Mics|Speakers)$/ { print $2 }' |
    sort -u
}

jack_is_connected() {
  local kind="$1" card_id card_index control

  for card_id in /proc/asound/card*/id; do
    [[ -r "$card_id" ]] || continue
    [[ "$(<"$card_id")" == "AppleJ314" ]] || continue
    card_index="${card_id%/id}"
    card_index="${card_index##*/card}"
    break
  done

  [[ -n "${card_index:-}" ]] || return 1
  if [[ "$kind" == "sources" ]]; then
    control="Headset Mic Jack"
  else
    control="Headphone Jack"
  fi

  amixer -c "$card_index" cget "iface=CARD,name='$control'" 2>/dev/null |
    grep -q 'values=on'
}

external_alsa_card_is_connected() {
  local kind="$1" card_dir card_name pcm_suffix

  if [[ "$kind" == "sources" ]]; then
    pcm_suffix=c
  else
    pcm_suffix=p
  fi

  for card_dir in /proc/asound/card[0-9]*; do
    [[ -r "$card_dir/id" ]] || continue
    card_name="$(<"$card_dir/id")"
    [[ "$card_name" == AppleJ314* ]] && continue
    compgen -G "$card_dir/pcm*$pcm_suffix" >/dev/null && return 0
  done

  return 1
}

external_nodes() {
  local kind="$1" builtin="$2" nodes

  nodes="$(node_names "$kind" | awk -v builtin="$builtin" '$0 != builtin')"

  if ! jack_is_connected "$kind"; then
    if [[ "$kind" == "sources" ]]; then
      nodes="$(grep -Fvx 'alsa_input.platform-sound.HiFi__Headset__source' <<<"$nodes")"
    else
      nodes="$(grep -Fvx 'alsa_output.platform-sound.HiFi__Headphones__sink' <<<"$nodes")"
    fi
  fi

  if ! external_alsa_card_is_connected "$kind"; then
    nodes="$(grep -Fv '.usb-' <<<"$nodes")"
  fi

  printf '%s\n' "$nodes" | sed '/^$/d'
}

node_exists() {
  local nodes="$1" target="$2"

  grep -Fxq -- "$target" <<<"$nodes"
}

newest_external_node() {
  local current="$1" previous="$2"

  comm -13 \
    <(printf '%s\n' "$previous" | sed '/^$/d' | sort -u) \
    <(printf '%s\n' "$current" | sed '/^$/d' | sort -u) |
    tail -n 1
}

move_application_streams() {
  local kind="$1" target="$2" stream_kind move_command

  if [[ "$kind" == "source" ]]; then
    stream_kind="source-outputs"
    move_command="move-source-output"
  else
    stream_kind="sink-inputs"
    move_command="move-sink-input"
  fi

  while read -r stream_id client_id _; do
    [[ -n "${stream_id:-}" && "${client_id:-}" != "-" ]] || continue
    pactl "$move_command" "$stream_id" "$target" 2>/dev/null || true
  done < <(pactl list short "$stream_kind" 2>/dev/null)
}

configured_default() {
  local kind="$1"

  timeout 3 pw-metadata -n default 2>/dev/null |
    grep "key:'default.configured.audio.$kind'" |
    sed -n 's/.*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' |
    tail -n 1
}

apply_default() {
  local kind="$1" target="$2" builtin current selected default_id changed=0

  [[ -n "$target" ]] || return 0

  if [[ "$kind" == "source" ]]; then
    builtin="$builtin_source"
    selected="$selected_source"
    default_id=1
  else
    builtin="$builtin_sink"
    selected="$selected_sink"
    default_id=0
  fi

  current="$(configured_default "$kind")"
  if [[ "$target" == "$builtin" ]]; then
    if [[ -n "$current" ]]; then
      wpctl clear-default "$default_id"
      changed=1
    fi
  elif [[ "$current" != "$target" ]]; then
    pactl "set-default-$kind" "$target"
    changed=1
  fi

  if (( changed )) || [[ "$selected" != "$target" ]]; then
    move_application_streams "$kind" "$target"
    logger -t omarchy-audio-graph-guard "Selected $kind: $target"
  fi

  if [[ "$kind" == "source" ]]; then
    selected_source="$target"
  else
    selected_sink="$target"
  fi
}

manage_device_kind() {
  local kind="$1" builtin="$2" known="$3"
  local nodes external new_external target=""

  nodes="$(node_names "${kind}s")" || return 0
  external="$(external_nodes "${kind}s" "$builtin")" || return 0
  new_external="$(newest_external_node "$external" "$known")"

  if [[ -n "$new_external" ]]; then
    target="$new_external"
  elif [[ "$kind" == "source" && "$selected_source" == "$builtin" ]] &&
    node_exists "$nodes" "$builtin"; then
    target="$builtin"
  elif [[ "$kind" == "source" ]] && node_exists "$external" "$selected_source"; then
    target="$selected_source"
  elif [[ "$kind" == "sink" && "$selected_sink" == "$builtin" ]] &&
    node_exists "$nodes" "$builtin"; then
    target="$builtin"
  elif [[ "$kind" == "sink" ]] && node_exists "$external" "$selected_sink"; then
    target="$selected_sink"
  elif [[ -n "$external" ]]; then
    target="$(tail -n 1 <<<"$external")"
  elif node_exists "$nodes" "$builtin"; then
    target="$builtin"
  fi

  apply_default "$kind" "$target"

  if [[ "$kind" == "source" ]]; then
    known_sources="$external"
  else
    known_sinks="$external"
  fi
}

manage_audio_devices() {
  audio_graph_is_healthy || return 0
  manage_device_kind source "$builtin_source" "$known_sources"
  manage_device_kind sink "$builtin_sink" "$known_sinks"
}

if [[ "${1:-}" == "--check" ]]; then
  audio_graph_is_healthy
  exit
fi

if [[ "${1:-}" == "--recover" ]]; then
  rebuild_audio_graph
  manage_audio_devices
  exit
fi

# At boot, the user manager can reach default.target a moment before the
# PipeWire graph has finished creating the Asahi DSP nodes. Give it a short
# grace period so normal initialization is not mistaken for graph failure.
for _ in {1..20}; do
  audio_graph_is_healthy && break
  sleep 0.25
done

while true; do
  rebuild_audio_graph
  manage_audio_devices
  sleep 2
done
